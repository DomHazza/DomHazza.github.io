---
import { LINKS } from '../consts';

const nav: { href: string; label: string; newTab?: boolean }[] = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: LINKS.github, label: 'Github', newTab: true },
  { href: '/cv.pdf', label: 'CV', newTab: true },
  { href: '/thesis.pdf', label: 'Thesis', newTab: true },
];

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const target = href.replace(/\/+$/, '') || '/';
  return current === target || current.startsWith(`${target}/`);
};
---

<header class="border-b border-rule">
  <div
    class="mx-auto flex max-w-[680px] flex-wrap items-baseline justify-end gap-x-6 gap-y-1 px-6 py-5"
  >
    <nav aria-label="Main navigation" class="flex gap-5 text-sm">
      {
        nav.map(({ href, label, newTab }) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            {...(newTab ? { target: '_blank', rel: 'noopener' } : {})}
            class:list={[
              'transition-colors hover:text-accent',
              isActive(href)
                ? 'text-ink underline decoration-accent decoration-1 underline-offset-[6px]'
                : 'text-muted',
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

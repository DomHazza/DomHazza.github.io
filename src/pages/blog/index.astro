---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts } from '../../utils/content';

const posts = await getPosts();
---

<BaseLayout
  title="Blog"
  description="Short notes on engineering, machine learning, and whatever else seems worth writing down."
>
  <h1 class="font-display text-4xl font-semibold tracking-tight">Blog</h1>
  <p class="mt-4 leading-relaxed text-muted">
    Short notes on engineering, machine learning, and whatever else seems worth writing down.
  </p>
  <div class="mt-8 divide-y divide-rule border-t border-rule">
    {
      posts.map((post) => (
        <article class="py-7">
          <p class="text-sm text-muted">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </p>
          <h2 class="mt-1.5 font-display text-xl font-semibold leading-snug">
            <a href={`/blog/${post.id}/`} class="transition-colors hover:text-accent">
              {post.data.title}
            </a>
          </h2>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{post.data.description}</p>
        </article>
      ))
    }
  </div>
</BaseLayout>

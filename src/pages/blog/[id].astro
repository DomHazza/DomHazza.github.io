---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts } from '../../utils/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, date, tags } = post.data;
const { Content } = await render(post);

const related = post.data.relatedProject ? await getEntry(post.data.relatedProject) : undefined;
// A draft project page is not built in production, so don't link to it.
const showRelated = related && (import.meta.env.DEV || !related.data.draft);
---

<BaseLayout title={title} description={description}>
  <article>
    <header>
      <p class="text-sm text-muted">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {tags.length > 0 && ` · ${tags.join(' · ')}`}
      </p>
      <h1 class="mt-3 font-display text-4xl font-semibold leading-tight tracking-tight">{title}</h1>
    </header>
    <div class="prose mt-8">
      <Content />
    </div>
  </article>

  {
    showRelated && (
      <aside class="mt-12 border-t border-rule pt-6 text-sm">
        <span class="text-muted">Related project:</span>
        <a
          href={`/projects/${related.id}/`}
          class="ml-1 font-medium text-accent underline decoration-accent/40 decoration-1 underline-offset-4 transition-colors hover:decoration-accent"
        >
          {related.data.title}
        </a>
      </aside>
    )
  }

  <p class="mt-12">
    <a href="/blog/" class="text-sm font-medium text-accent">← All posts</a>
  </p>
</BaseLayout>

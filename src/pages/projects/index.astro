---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../utils/content';

const projects = await getProjects();
// The adjoint aerofoil write-up is still in progress, so keep it off this index.
// The page stays reachable via its direct link elsewhere.
const listed = projects.filter((project) => project.id !== 'aerofoil-optimisation');
// Featured entries float to the top; each group stays in date order.
const ordered = [...listed].sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---

<BaseLayout
  title="Projects"
  description="Selected technical and creative projects — machine learning, simulation, and the occasional game."
>
  <h1 class="font-display text-4xl font-semibold tracking-tight">Projects</h1>
  <div class="mt-8 divide-y divide-rule border-t border-rule">
    {ordered.map((project) => <ProjectCard project={project} />)}
  </div>
</BaseLayout>

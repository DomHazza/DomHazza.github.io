---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section>
    <h1 class="font-display text-5xl font-semibold leading-[1.04] tracking-tight sm:text-6xl">
      Dominic Harrington
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-muted">
      Internships at Jane Street, F1 and Nuclear Fusion. University of Cambridge MEng, specialised
      in artificial intelligence.
    </p>
    <p class="mt-6">
      I like pointing machine learning at physical problems — cutting the error of downforce
      simulations at the Williams F1 team, placing sensors for fusion experiments at the UK Atomic
      Energy Authority, and segmenting MRI scans for my master&rsquo;s thesis.
    </p>
  </section>
</BaseLayout>

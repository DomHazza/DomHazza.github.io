---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section>
    <h1 class="font-display text-5xl font-semibold leading-[1.04] tracking-tight sm:text-6xl">
      Dominic Harrington
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-muted">
      Internships at Jane Street, F1 and Nuclear Fusion.<br />
      University of Cambridge MEng, specialised in artificial intelligence.
    </p>
    <p class="mt-6">
      I am most interested in using data to solve messy, real-world problems. This includes tracking
      financial penalty payments at Jane Street, segmenting MRI scans for my master&rsquo;s thesis,
      identifying the optimal sensor locations for experiments at the UK Atomic Energy Authority, and
      cutting the
      error of downforce simulations at the Williams F1 team.
    </p>
    <ul class="mt-6 flex flex-col gap-2 text-[0.9375rem]">
      <li>
        <a
          href="/projects/bayesian-mri/"
          class="font-medium text-accent underline decoration-accent/40 decoration-1 underline-offset-4 transition-colors hover:decoration-accent"
        >
          Accelerating Flow MRI with Bayesian inference →
        </a>
      </li>
      <li>
        <a
          href="/projects/aerofoil-optimisation/"
          class="font-medium text-accent underline decoration-accent/40 decoration-1 underline-offset-4 transition-colors hover:decoration-accent"
        >
          Aerofoil optimisation with adjoint methods →
        </a>
      </li>
    </ul>
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
      <img
        src="/IMG_1497.jpg"
        alt="Launching a hand-built model aircraft in a field"
        width="1179"
        height="1179"
        loading="lazy"
        class="aspect-square w-full rounded-lg object-cover"
      />
      <img
        src="/IMG_1498.jpg"
        alt="In black tie beside a Williams Formula 1 car"
        width="1179"
        height="1179"
        loading="lazy"
        class="aspect-square w-full rounded-lg object-cover"
      />
    </div>
  </section>
</BaseLayout>

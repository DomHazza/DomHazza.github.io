---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <p class="text-sm uppercase tracking-[0.18em] text-muted">404</p>
  <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight">Page not found</h1>
  <p class="mt-4 text-muted">That page doesn&rsquo;t exist — or it has moved.</p>
  <p class="mt-8">
    <a
      href="/"
      class="font-medium text-accent underline decoration-accent/40 decoration-1 underline-offset-4 transition-colors hover:decoration-accent"
    >
      ← Back home
    </a>
  </p>
</BaseLayout>
